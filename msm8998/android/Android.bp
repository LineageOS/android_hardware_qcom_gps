package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "hardware_qcom_gps_msm8998_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    //   legacy_not_a_contribution
    default_applicable_licenses: ["hardware_qcom_gps_msm8998_license"],
}

cc_library_shared {
    name: "android.hardware.gnss@1.0-impl-qti",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "AGnss.cpp",
        "Gnss.cpp",
        "GnssBatching.cpp",
        "GnssGeofencing.cpp",
        "GnssMeasurement.cpp",
        "GnssNi.cpp",
        "GnssConfiguration.cpp",
        "GnssDebug.cpp",
        "AGnssRil.cpp",
    ] + [
        "location_api/LocationUtil.cpp",
        "location_api/GnssAPIClient.cpp",
        "location_api/GeofenceAPIClient.cpp",
        "location_api/FlpAPIClient.cpp",
        "location_api/GnssMeasurementAPIClient.cpp",
    ],

    local_include_dirs: ["location_api"],

    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
    ],

    shared_libs: [
        "liblog",
        "libhidlbase",
        "libcutils",
        "libutils",
        "android.hardware.gnss@1.0",
    ] + [
        "libloc_core",
        "libgps.utils",
        "libdl",
        "libloc_pla",
        "liblocation_api",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-format",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
    ],
}

cc_binary {
    name: "android.hardware.gnss@1.0-service-qti",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.gnss@1.0-service-qti.rc"],
    srcs: ["service.cpp"],

    local_include_dirs: ["location_api"],

    header_libs: [
        "libgps.utils_headers",
        "libloc_core_headers",
        "libloc_pla_headers",
        "liblocation_api_headers",
    ],

    shared_libs: [
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
    ] + [
        "libhidlbase",
        "android.hardware.gnss@1.0",
    ],

    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-format",
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
    ],
}
